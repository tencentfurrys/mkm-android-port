			"isInstantText":false,
			"speakerColorRGB":{"r":1.0,"g":0.15,"b":0.15,"a":1.0},
			"speakerName":"Maya",
			"speakerDialogue":"Okay, so we are on the right place. But what do we do now?",
			"miscText":"Plan of Action"
