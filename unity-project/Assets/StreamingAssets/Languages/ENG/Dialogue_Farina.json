			"isInstantText":false,
			"speakerColorRGB":{"r":0.95,"g":0.75,"b":0.2,"a":1.0},
			"speakerName":"Farina",
			"speakerDialogue":"The sailors called it 'The Island of Dread', but the bishop called it 'The Summer Isle'. That name matches with the ancient maps that I've found around here.",
			"miscText":"Arrival on the island"
		},
		{
			"id":100000,
			"actionList":[{"whoID":1,"whichACT":0},{"whoID":13,"whichACT":2}],
			"soundList":[],"letterTone":13,
			"cameraMovement":{"x":0.0,"y":-0.5},
			"isInstantText":false,
			"speakerColorRGB":{"r":0.95,"g":0.75,"b":0.2,"a":1.0},
			"speakerName":"Farina",
			"speakerDialogue":"This means that the artifact that you were tasked with finding has to be somewhere on this island!",
			"miscText":"Arrival on the island"
		},
		{
			"id":100001,
			"actionList":[{"whoID":1,"whichACT":2},{"whoID":13,"whichACT":0}],
