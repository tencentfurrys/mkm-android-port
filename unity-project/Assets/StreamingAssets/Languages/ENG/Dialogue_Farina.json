			"speakerColorRGB":{"r":0.95,"g":0.75,"b":0.2,"a":1.0},
			"speakerName":"Farina",
			"speakerDialogue":"Yes. I've found some maps here that confirm this.<@:LINE_BREAK>What's more, coincidence or not, this seems to be our intended original destination!",
			"miscText":"Arrival on the island"
		},
		{
			"id":100000,
			"actionList":[{"whoID":1,"whichACT":2},{"whoID":13,"whichACT":0}],
