			"speakerColorRGB":{"r":0.95,"g":0.75,"b":0.2,"a":1.0},
			"speakerName":"Farina",
			"speakerDialogue":"We do need to learn more about this island as a whole, and I'll see if I can find clues as to where the artifact might be located.",
			"miscText":"Plan of Action"
		},
