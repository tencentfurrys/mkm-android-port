			"speakerColorRGB":{"r":0.95,"g":0.75,"b":0.2,"a":1.0},
			"speakerName":"Farina",
			"speakerDialogue":"I'm not as strong as you to survive out there Miss Maya, and this library seems safe enough, so I'll stay here and research these books for more information.",
			"miscText":"Plan of Action"
		},
